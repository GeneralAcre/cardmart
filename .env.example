# Postgres — from Vercel's Storage tab (Neon/Vercel Postgres integration),
# or any local/hosted Postgres. DATABASE_URL is the pooled connection (used
# by the app at runtime); DIRECT_URL is the unpooled one (used for migrations).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Vercel Blob — stores verification photo files (Postgres only holds their
# URL). From the Vercel dashboard: Storage tab -> Create Database -> Blob,
# then copy the token it gives you (or `vercel env pull .env` if linked).
BLOB_READ_WRITE_TOKEN=""
