# Postgres — from Vercel's Storage tab (Neon/Vercel Postgres integration),
# or any local/hosted Postgres. DATABASE_URL is the pooled connection (used
# by the app at runtime); DIRECT_URL is the unpooled one (used for migrations).
# sslmode=verify-full (not just "require") avoids a node-postgres deprecation
# warning — a future pg-connection-string major version stops treating
# "require" as an alias for full certificate verification.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Privy — sign-in (Google, email) and embedded wallet creation. Create an
# app at https://dashboard.privy.io, enable Google + Email login methods,
# and set embedded wallets to create on login for users without one
# (Solana chain type). App ID is public; App Secret is server-only.
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# Vercel Blob — stores verification photo files (Postgres only holds their
# URL). From the Vercel dashboard: Storage tab -> Create Database -> Blob,
# then copy the token it gives you (or `vercel env pull .env` if linked).
BLOB_READ_WRITE_TOKEN=""

# PSA Public API — real cert-number lookups against PSA's actual database
# (not a mock). Register at https://www.psacard.com/publicapi, agree to the
# API End User Agreement, and generate a bearer token. Without this, PSA
# verification is skipped and the app falls back to self-declared data.
PSA_API_TOKEN=""

# TCG API (https://tcgapi.dev) — reference market price for raw/ungraded
# trading cards (Pokemon/TCG only; PSA has no price-guide endpoint at all,
# so this is a separate source). Free tier: register with email/password,
# verify the email, then create a key — 100 requests/day, no card needed.
# Without this, no reference price is shown; nothing else is affected.
TCG_API_KEY=""

# eBay Browse API (https://developer.ebay.com/api-docs/buy/browse/overview.html)
# — a live current-asking-price reference that covers every category (sports
# cards, comics too, not just Pokemon), grade-aware. Register a "Production"
# keyset at https://developer.ebay.com/my/keys (free, self-serve — no
# approval wait, unlike PSA) and copy the App ID / Cert ID from there. Uses
# the client-credentials OAuth flow, not a user-authorized token. Without
# these, the item page still links straight to eBay's own sold-listings
# search (needs no API key at all) — it just skips the live median/range.
EBAY_APP_ID=""
EBAY_CERT_ID=""

# Escrow program (see contracts/escrow/README.md) — a real Solana devnet
# program that holds buyer payments in a PDA until warehouse approval
# releases or refunds them. Deploy your OWN instance rather than reusing
# someone else's; NEVER put the program's upgrade-authority keypair here.
#
# NEXT_PUBLIC_ESCROW_PROGRAM_ID is public (it's exposed to the browser on
# purpose — it just says which program to talk to). Get it from
# `anchor build` + `solana program deploy` output.
NEXT_PUBLIC_ESCROW_PROGRAM_ID=""
# ESCROW_AUTHORITY_SECRET_KEY is a secret — the raw 64-number JSON array a
# `solana-keygen` keypair file contains, for the SEPARATE "escrow authority"
# keypair (never the upgrade authority). Set up via `scripts/init-escrow-config.mjs`.
# Without this, buy/release/refund silently fall back to the old simulated
# (DB-only) escrow flow — nothing breaks, you just don't get real fund custody.
ESCROW_AUTHORITY_SECRET_KEY=""

# QA verify endpoint (app/api/verify) — lets a separate internal QA tool
# check a serial number against PSA's live cert database and this
# platform's own records. Shared-secret auth: the QA app sends this same
# value as "Authorization: Bearer <key>". Generate one with
# `openssl rand -hex 32` (or any long random string) — without it, the
# endpoint rejects every request with 401.
QA_VERIFY_API_KEY=""

# Resend (https://resend.com) — emails the important notifications (item
# sold, outbid, auction won, offers, trades, grading done, KYC result) and
# the first unread chat message. Create an API key (a "Sending access" key
# is enough). Without a verified domain Resend only delivers to your own
# account's address from onboarding@resend.dev — verify a domain and set
# EMAIL_FROM (e.g. "CardMart <noreply@yourdomain.com>") to email real users.
# Without RESEND_API_KEY, notifications stay in-app only; nothing breaks.
RESEND_API_KEY=""
EMAIL_FROM=""

# Staff back office on its own domain (optional). When ADMIN_HOST is set,
# /admin is only served on that host ("/" there is the staff sign-in page) and
# answers 404 on every other host. MAIN_HOST is where marketplace links
# clicked inside the back office go. Leave both unset locally to use
# http://localhost:3000/admin. Add ADMIN_HOST to Privy's allowed origins too.
# ADMIN_HOST="cardmarts-admin.vercel.app"
# MAIN_HOST="cardmarts.vercel.app"

# Buying agent (/agent). ANTHROPIC_API_KEY switches on the AI (Claude plans
# tasks and judges listings). AGENT_WALLET_SECRET encrypts each user's agent
# wallet key — any long random string; keep it identical everywhere that
# shares the database, and never change it once wallets exist.
# ANTHROPIC_API_KEY="sk-ant-..."
# AGENT_WALLET_SECRET="..."
