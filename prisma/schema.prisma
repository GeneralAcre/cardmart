generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GradingCompany {
  // Cards (TRADING_CARD / SPORTS_CARD).
  PSA
  BGS
  // Comics (COMIC); also grades cards.
  CGC
  // Not an actual grading company — marks a raw/ungraded Self-Mint item that
  // was verified by camera only, never sent to a real grading company.
  RAW
}

// The only two games CardMart trades. Existing rows default to POKEMON —
// every non-sports card on the platform when this was added was Pokémon.
enum CardGame {
  POKEMON
  ONE_PIECE
}

enum AssetCategory {
  TRADING_CARD
  SPORTS_CARD
  COMIC
}

// Marketplace-facing badge shown on product cards.
enum MarketStatus {
  READY_TO_SHIP
  IN_VAULT
  IN_ESCROW
  DELISTED
  // Up for auction — deliberately excluded from the marketplace's own
  // visible-statuses list (see MARKETPLACE_VISIBLE_STATUSES in
  // lib/queries.ts), so an auctioned item only shows on /auctions, never
  // in the fixed-price marketplace grid.
  IN_AUCTION
}

enum AuctionStatus {
  ACTIVE
  // Settled with a winner: the winning bid's locked funds became the sale's
  // escrow (see settleAuction / claimAuctionWin in lib/actions.ts).
  ENDED_SOLD
  ENDED_NO_BIDS
  // Legacy only: the winning bid was placed before bids locked funds, and
  // the winner never claimed within the claim window, so the item was
  // released back to the seller. Bids made since always hold a real lock.
  ENDED_UNCLAIMED
  // Seller-cancelled — only allowed while there are zero bids, so no bidder
  // is ever pulled out from under after committing to a price.
  CANCELLED
}

enum BidLockStatus {
  // Funds locked and still the bidder's standing bid.
  HELD
  // Outbid (or otherwise released) and the lock returned to the bidder.
  REFUNDED
  // The winning bid — its lock became the sale's EscrowTransaction.
  CONVERTED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// Internal physical-custody pipeline driven by the warehouse dashboard.
enum PipelineStage {
  NONE
  AWAITING_SELLER_SHIPMENT
  IN_TRANSIT_TO_WAREHOUSE
  IN_INSPECTION
  REJECTED
  IN_TRANSIT_TO_BUYER
  DELIVERED
}

enum FulfillmentChoice {
  SHIP
  VAULT
}

enum EscrowStatus {
  LOCKED
  RELEASED
  REFUNDED
}

enum InboundStatus {
  // Sold, but the seller hasn't sent the card to the warehouse yet. They
  // have until shipByDeadline; after that the sale is cancelled and the
  // buyer refunded (EXPIRED) — see expireOverdueSellerShipments.
  AWAITING_SELLER_SHIPMENT
  EXPIRED
  PENDING_INSPECTION
  APPROVED_SHIP
  APPROVED_VAULT
  REJECTED
}

enum ProvenanceType {
  MINTED_DIGITAL_TWIN
  LISTED
  DELISTED
  ESCROW_LOCKED
  SHIPPED_TO_WAREHOUSE
  INSPECTION_PASSED
  INSPECTION_REJECTED
  DEPOSITED_TO_VAULT
  DELIVERED_TO_BUYER
  OWNERSHIP_TRANSFERRED
  RELISTED
  REDEEMED
  TOKEN_BURNED
  SWAPPED
  ESCROW_REFUNDED
  LISTING_APPROVED
}

// The two onboarding/pricing models for getting an item onto the platform.
enum VerificationPackage {
  // Flat mock fee. Seller already holds an official grading company slab and
  // self-declares + verifies it; seller bears the later cost of shipping the
  // physical item to the warehouse once it sells.
  SELF_MINT
  // Higher mock package fee that bundles shipping the raw item to the
  // grading company, the grading company's own grading fee, and digital
  // twin minting — all covered by the platform out of the package price.
  FULL_SERVICE
}

enum GradingSubmissionStatus {
  AWAITING_SHIPMENT_TO_GRADER
  AT_GRADING_COMPANY
  GRADED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  image     String?
  createdAt DateTime @default(now())

  // Privy identity — the stable ID from Privy's own user object, independent
  // of which login method (Google, email) the user signed in with.
  privyUserId   String? @unique
  // Real embedded wallet address Privy creates for users without one, e.g.
  // signing in with Gmail. Distinct from walletMock, which only seeded demo
  // personas use (they have no real Privy identity).
  walletAddress String?

  // App-specific profile, filled in during onboarding after first sign-in.
  handle          String? @unique
  walletMock      String?
  shippingAddress String?
  phone           String?
  profileComplete Boolean @default(false)

  // Gates the /admin back office and its Server Actions — staff only.
  // Defaults false; granted by another admin from /admin/users (or the
  // scripts/make-admin.ts bootstrap for the very first one).
  isAdmin Boolean @default(false)

  // Staff seller-management control (back office "suspension/ban"). A
  // banned user can't create new listings, submit for grading, or buy —
  // existing listings/escrows are left alone (no destructive side effect,
  // reversible by un-banning). Checked in lib/actions.ts, never surfaced
  // anywhere on the buyer/seller side beyond a plain rejection message.
  isBanned Boolean @default(false)

  // Identity verification (KYC): the details below plus two live camera
  // photos — the ID card itself and a selfie holding it. The photos live in a
  // separate PRIVATE Vercel Blob store (KYC_BLOB_READ_WRITE_TOKEN) and are
  // only ever served to staff through /api/admin/kyc-photo; these columns
  // hold their private blob URLs, which are useless without the store token.
  // Only the last 4 characters of the ID number are stored.
  kycStatus       KycStatus  @default(NONE)
  kycLegalName    String?
  kycDateOfBirth  DateTime?
  kycIdType       KycIdType?
  kycIdLast4      String?
  kycIdPhotoUrl   String?
  kycSelfieUrl    String?
  kycSubmittedAt  DateTime?
  kycReviewedAt   DateTime?
  kycRejectReason String?

  listedAssets        Asset[]             @relation("AssetSeller")
  ownedAssets         Asset[]             @relation("AssetOwner")
  provenanceEvents    ProvenanceEvent[]
  purchases           EscrowTransaction[] @relation("EscrowBuyer")
  sales               EscrowTransaction[] @relation("EscrowSeller")
  gradingSubmissions  GradingSubmission[] @relation("GradingSubmissionSeller")
  reviewsReceived     Review[]            @relation("SellerReviews")
  reviewsGiven        Review[]            @relation("BuyerReviews")
  watchlist           WatchlistItem[]
  notifications       Notification[]
  bids                Bid[]
  offersMade          Offer[]             @relation("OfferBuyer")
  offersReceived      Offer[]             @relation("OfferSeller")
  conversationsA      Conversation[]      @relation("ConversationUserA")
  conversationsB      Conversation[]      @relation("ConversationUserB")
  messagesSent        Message[]
  wantedCards         WantedCard[]
  tradeOffersMade     TradeOffer[]        @relation("TradeOfferProposer")
  tradeOffersReceived TradeOffer[]        @relation("TradeOfferRecipient")
  shipmentsReceived   Shipment[]          @relation("ShipmentRecipient")
  disputesOpened      Dispute[]           @relation("DisputeOpener")

  @@index([kycStatus])
}

model Asset {
  id                  String              @id @default(cuid())
  name                String
  subtitle            String
  category            AssetCategory
  game                CardGame            @default(POKEMON)
  gradingCompany      GradingCompany
  grade               Float?
  // True only for a BGS "Black Label" 10 — a distinct top tier (every
  // sub-grade a perfect 10) from a regular Pristine 10, which shares the
  // same numeric grade and so can't be told apart by grade+gradingCompany
  // alone. Meaningless for any other company or grade — see
  // lib/labels.ts::gradeTierLabel.
  isBlackLabel        Boolean             @default(false)
  serial              String              @unique
  themeIndex          Int                 @default(0)
  priceThb            Int?
  forSale             Boolean             @default(false)
  vaulted             Boolean             @default(false)
  marketStatus        MarketStatus        @default(READY_TO_SHIP)
  pipelineStage       PipelineStage       @default(NONE)
  mockMintTx          String
  verificationPackage VerificationPackage @default(SELF_MINT)
  mintFeeThb          Int                 @default(50)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Real SPL Token mint address for this digital twin (decimals 0, fixed
  // supply of 1, mint authority permanently revoked after minting — see
  // lib/web3/token-server.ts). Null for assets minted before this existed,
  // or when ESCROW_AUTHORITY_SECRET_KEY isn't configured — those fall back
  // to the old DB-only simulated mint/transfer, same degrade-gracefully
  // pattern as EscrowTransaction.onChain.
  mintAddress      String?
  // Whether the current owner has a live SPL delegate approval (ApproveChecked)
  // authorizing the platform's escrow authority to move this token on their
  // behalf at the next sale. Set true by a real Approve, false again after
  // that approval is consumed by a real transfer or explicitly revoked
  // (delist). Meaningless when mintAddress is null.
  transferApproved Boolean @default(false)

  // Physical shelf/box location inside the warehouse vault — staff-only data,
  // set when an item is deposited and editable later (item gets moved, or
  // pulled for redemption/withdrawal). Never surfaced on any buyer/seller
  // page; only read by the admin-only queries and components under
  // components/warehouse/.
  vaultLocation String?

  // Set when the owner redeemed the physical item out of the vault. The
  // digital twin is burned at that moment (burnTxSignature — a real SPL
  // BurnChecked when the asset has a real mint), so a redeemed asset can
  // never be listed, auctioned or traded again.
  redeemedAt      DateTime?
  burnTxSignature String?

  // Official catalogue image of this card (TCGplayer, via TCG API) — a
  // reference picture shown when there's no real verification photo, never
  // presented as a photo of this physical copy. See lib/card-catalog.ts.
  catalogImageUrl String?

  sellerId String
  seller   User   @relation("AssetSeller", fields: [sellerId], references: [id])
  ownerId  String
  owner    User   @relation("AssetOwner", fields: [ownerId], references: [id])

  provenance         ProvenanceEvent[]
  escrowTxs          EscrowTransaction[]
  inboundPackages    InboundPackage[]
  gradingSubmission  GradingSubmission?
  verificationPhotos VerificationPhoto[]
  priceSnapshots     PriceSnapshot[]
  watchedBy          WatchlistItem[]
  // Every auction this item has ever had, not just the current one — an
  // asset can be re-auctioned after a no-bid ending or a no-bids
  // cancellation, so this is intentionally one-to-many, not one-to-one.
  auctions           Auction[]
  offers             Offer[]
  tradeOffersFor     TradeOffer[]        @relation("TradeOfferRequested")
  tradeOffersWith    TradeOffer[]        @relation("TradeOfferOffered")
  shipments          Shipment[]

  @@index([sellerId])
  @@index([ownerId])
  // The marketplace's main query (getMarketplaceListings) filters on
  // marketStatus and sorts by createdAt on every single page load — without
  // this, Postgres has no choice but to scan every Asset row every time,
  // and that scan only gets slower as the table grows.
  @@index([marketStatus, createdAt])
  // getTrendingListings filters on exactly this pair (forSale + marketStatus)
  // before it ever touches price data — same reasoning, different query shape.
  @@index([forSale, marketStatus])
}

// A separate sale channel from the fixed-price marketplace (Asset.forSale/
// priceThb) — an item is either fixed-price-listed or auctioned, never
// both (enforced in lib/actions.ts::startAuction). No cron/background job
// settles these: expiry is checked lazily whenever the auction is read
// (see settleIfExpired in lib/queries.ts), and a sold auction still needs
// its winner to actively claim it — see AuctionStatus.ENDED_SOLD.
model Auction {
  id            String        @id @default(cuid())
  startPriceThb Int
  // Highest bid so far, denormalized from Bid for cheap list-page reads —
  // same "cache the current figure" pattern as PriceSnapshot/Asset.priceThb.
  // Null until the first bid comes in.
  currentBidThb Int?
  // An auction may be scheduled ahead of time. It is visible and accepts bids
  // only once this time has arrived.
  startTime     DateTime      @default(now())
  endTime       DateTime
  status        AuctionStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  settledAt     DateTime?
  // Set once bidding closes with a winner on a non-vaulted item: the
  // winner's money is already locked, they just pick ship or vault by then.
  // After it passes the item defaults to the vault (see settleAuction).
  claimDeadline DateTime?

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  bids Bid[]

  @@index([assetId])
  @@index([status, startTime])
  @@index([status, endTime])
}

model Bid {
  id        String   @id @default(cuid())
  amountThb Int
  createdAt DateTime @default(now())

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id])
  bidderId  String
  bidder    User    @relation(fields: [bidderId], references: [id])

  // Every bid locks its full amount in the escrow program (the same
  // lock_payment a normal purchase uses). Outbid locks are refunded by the
  // escrow authority; the winning lock becomes the sale's EscrowTransaction.
  // lockStatus is null only for bids placed before locking existed.
  lockStatus      BidLockStatus?
  onChain         Boolean        @default(false)
  onChainTradeId  BigInt?
  tradeAccount    String?
  lamportsLocked  BigInt?
  lockTxSignature String?

  @@index([auctionId, amountThb])
  @@index([bidderId])
}

// A buyer-proposed price on a fixed-price listing. Accepting an offer
// doesn't transfer anything by itself — it just clears the buyer to
// complete the purchase at that price (completeOfferPurchase in
// lib/actions.ts), the same real wallet-signed escrow lock any other
// purchase needs.
model Offer {
  id          String      @id @default(cuid())
  amountThb   Int
  message     String?
  status      OfferStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  respondedAt DateTime?

  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id])
  buyerId  String
  buyer    User   @relation("OfferBuyer", fields: [buyerId], references: [id])
  sellerId String
  seller   User   @relation("OfferSeller", fields: [sellerId], references: [id])

  @@index([assetId, status])
  @@index([sellerId, status])
  @@index([buyerId, status])
}

// A buyer saving a listing to keep an eye on — one row per (user, asset),
// so watching twice is a no-op rather than a duplicate row.
model WatchlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id])
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  @@unique([userId, assetId])
  @@index([userId])
}

// A real point-in-time record of an asset's listing price — one row per
// list/reprice/sale event, never backfilled or fabricated. The marketplace
// price chart reads straight from this table, so a brand-new listing shows
// a flat/short line rather than a fake trend; it only fills in as real
// pricing events actually happen.
enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum KycIdType {
  NATIONAL_ID
  PASSPORT
  DRIVING_LICENSE
}

enum TradeOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  // Auto-closed because one of the two cards stopped being tradeable (sold,
  // redeemed, auctioned, or swapped in another trade) before a response.
  CANCELLED
}

// A card-for-card swap proposal between two vaulted items, optionally with
// a cash difference. cashThb > 0: the proposer adds cash on top of their
// card; cashThb < 0: the proposer asks the recipient to add cash. Whoever
// pays locks it in the same escrow program as a normal purchase (the
// proposer at proposal time, the recipient at acceptance), and it is
// released to the other side only when the swap completes.
model TradeOffer {
  id          String           @id @default(cuid())
  cashThb     Int              @default(0)
  message     String?
  status      TradeOfferStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  // Real on-chain lock of the proposer's cash (cashThb > 0 only) — same
  // fields and fallback rules as EscrowTransaction.
  cashOnChain      Boolean @default(false)
  cashTradeId      BigInt?
  cashTradeAccount String?
  cashLamports     BigInt?

  proposerId       String
  proposer         User   @relation("TradeOfferProposer", fields: [proposerId], references: [id])
  recipientId      String
  recipient        User   @relation("TradeOfferRecipient", fields: [recipientId], references: [id])
  // The recipient's card the proposer wants.
  requestedAssetId String
  requestedAsset   Asset  @relation("TradeOfferRequested", fields: [requestedAssetId], references: [id])
  // The proposer's card offered in exchange.
  offeredAssetId   String
  offeredAsset     Asset  @relation("TradeOfferOffered", fields: [offeredAssetId], references: [id])

  @@index([recipientId, status])
  @@index([proposerId, status])
  @@index([requestedAssetId, status])
  @@index([offeredAssetId, status])
}

// A "notify me when this card is listed" alert, matched against every new
// listing and relist (see notifyWantedCardMatches in lib/actions.ts): a
// case-insensitive substring match on the card name plus the optional
// grade / price / seller-trust constraints below.
model WantedCard {
  id             String          @id @default(cuid())
  query          String
  gradingCompany GradingCompany?
  minGrade       Float?
  blackLabelOnly Boolean         @default(false)
  maxPriceThb    Int?
  // Only alert for sellers with a verified identity or at least a 4-star rating.
  trustedOnly    Boolean         @default(false)
  createdAt      DateTime        @default(now())
  lastMatchedAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceSnapshot {
  id        String   @id @default(cuid())
  priceThb  Int
  createdAt DateTime @default(now())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  @@index([assetId, createdAt])
}

// A single live-camera capture taken during self-mint verification, proving
// the seller physically held the item at mint time (no gallery uploads).
// The file itself lives in Vercel Blob storage — this only stores its URL.
model VerificationPhoto {
  id        String   @id @default(cuid())
  viewKey   String
  viewLabel String
  url       String
  createdAt DateTime @default(now())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  @@index([assetId])
}

model GradingSubmission {
  id              String                  @id @default(cuid())
  itemName        String
  itemSubtitle    String
  category        AssetCategory
  game            CardGame                @default(POKEMON)
  gradingCompany  GradingCompany
  packagePriceThb Int
  status          GradingSubmissionStatus @default(AWAITING_SHIPMENT_TO_GRADER)
  mockPaymentTx   String
  createdAt       DateTime                @default(now())
  resolvedAt      DateTime?

  sellerId String
  seller   User   @relation("GradingSubmissionSeller", fields: [sellerId], references: [id])

  resultAssetId String? @unique
  resultAsset   Asset?  @relation(fields: [resultAssetId], references: [id])

  @@index([sellerId])
}

model ProvenanceEvent {
  id              String         @id @default(cuid())
  type            ProvenanceType
  note            String
  mockTxSignature String
  // True only when mockTxSignature is a real, signed Solana devnet
  // transaction (currently: a Memo instruction recorded at mint/list time)
  // rather than a randomly-generated placeholder string. Lets the UI show
  // a real, working Solana Explorer link only where one actually resolves.
  onChain         Boolean        @default(false)
  createdAt       DateTime       @default(now())

  assetId String
  asset   Asset   @relation(fields: [assetId], references: [id])
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([assetId])
}

model EscrowTransaction {
  id                String            @id @default(cuid())
  amountThb         Int
  fulfillmentChoice FulfillmentChoice
  status            EscrowStatus      @default(LOCKED)
  createdAt         DateTime          @default(now())
  releasedAt        DateTime?

  // Real on-chain custody via the escrow program in contracts/escrow — set
  // only when the buyer actually signed a lock_payment transaction, never
  // backfilled. Falls back to the old DB-only simulated flow when false (no
  // wallet available), same pattern as ProvenanceEvent.onChain.
  onChain        Boolean @default(false)
  onChainTradeId BigInt? // u64 seed used to derive the on-chain Trade PDA
  tradeAccount   String? // base58 address of the Trade PDA, for convenience
  lamportsLocked BigInt? // actual lamports locked on-chain (THB -> SOL at lock time)

  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id])
  buyerId  String
  buyer    User   @relation("EscrowBuyer", fields: [buyerId], references: [id])
  sellerId String
  seller   User   @relation("EscrowSeller", fields: [sellerId], references: [id])

  inboundPackage InboundPackage?
  review         Review?
  shipment       Shipment?
  dispute        Dispute?

  @@index([assetId])
  // getSellerProfile's sold-history section filters on exactly this pair on
  // every storefront page view — sellerId alone wasn't indexed at all.
  @@index([sellerId, status])
}

// A buyer's rating of the seller after a completed (RELEASED) purchase —
// one per escrow transaction, so a seller's aggregate rating only ever
// reflects real, completed sales, never something fabricated for display.
model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  sellerId String
  seller   User   @relation("SellerReviews", fields: [sellerId], references: [id])
  buyerId  String
  buyer    User   @relation("BuyerReviews", fields: [buyerId], references: [id])

  escrowTxId String            @unique
  escrowTx   EscrowTransaction @relation(fields: [escrowTxId], references: [id])

  @@index([sellerId])
}

model InboundPackage {
  id                     String         @id @default(cuid())
  declaredSerial         String
  declaredGradingCompany GradingCompany
  declaredGrade          Float
  officialSerial         String
  officialGradingCompany GradingCompany
  officialGrade          Float
  officialName           String
  status                 InboundStatus  @default(PENDING_INSPECTION)
  // When the package entered the inspection queue — the moment the seller
  // marked it shipped (or the sale time, for packages from before sellers
  // had a shipping step).
  arrivedAt              DateTime       @default(now())
  resolvedAt             DateTime?

  // The seller's leg: card from the seller to our warehouse.
  shipByDeadline       DateTime?
  sellerCarrier        String?
  sellerTrackingNumber String?
  sellerShippedAt      DateTime?

  assetId    String
  asset      Asset             @relation(fields: [assetId], references: [id])
  escrowTxId String            @unique
  escrowTx   EscrowTransaction @relation(fields: [escrowTxId], references: [id])

  @@index([assetId])
  @@index([status, shipByDeadline])
}

// Footer "Contact & Support" form submissions. Not tied to a User — the
// site's contact form is open to signed-out visitors too.
// A private 1:1 thread between two users (typically a buyer and a seller,
// e.g. negotiating price before making a formal Offer). Exactly one row per
// pair: userAId is always the lexically smaller of the two ids, so the
// unique constraint covers both orderings.
model Conversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  // Bumped on every new message so the inbox sorts most-recent first.
  lastMessageAt DateTime @default(now())

  userAId  String
  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userBId  String
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id])
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  // Set when the recipient opens the thread — drives the header unread badge.
  readAt    DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime  @default(now())
  // Set when staff mark it dealt with in the back office support inbox.
  handledAt DateTime?

  @@index([handledAt, createdAt])
}

// A physical card leaving the warehouse for someone's home address — either
// a sale the buyer chose to have shipped (warehouseApproveShip) or an owner
// redeeming a vaulted card (vaultRedeem). Created when the card is approved
// to leave; staff add the courier and tracking number once it's collected.
// The address is a snapshot, so a later profile edit doesn't rewrite where
// a package already went.
enum ShipmentReason {
  SALE
  REDEEM
}

enum ShipmentStatus {
  AWAITING_DISPATCH
  SHIPPED
  DELIVERED
}

model Shipment {
  id              String         @id @default(cuid())
  reason          ShipmentReason
  status          ShipmentStatus @default(AWAITING_DISPATCH)
  shippingAddress String
  phone           String?
  carrier         String?
  trackingNumber  String?
  createdAt       DateTime       @default(now())
  shippedAt       DateTime?
  deliveredAt     DateTime?

  assetId     String
  asset       Asset              @relation(fields: [assetId], references: [id])
  recipientId String
  recipient   User               @relation("ShipmentRecipient", fields: [recipientId], references: [id])
  // Set for SALE shipments only.
  escrowTxId  String?            @unique
  escrowTx    EscrowTransaction? @relation(fields: [escrowTxId], references: [id])

  @@index([status, createdAt])
  @@index([assetId])
  @@index([recipientId])
}

// A buyer reporting a problem with a completed purchase (card never
// arrived, not as described, damaged). One per purchase. The escrow has
// already been released on-chain by then, so a refund is issued by staff
// outside the app — RESOLVED_REFUNDED records that it happened, it doesn't
// move funds itself.
enum DisputeReason {
  NOT_RECEIVED
  NOT_AS_DESCRIBED
  DAMAGED
  OTHER
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUNDED
  RESOLVED_NO_ACTION
}

model Dispute {
  id             String        @id @default(cuid())
  reason         DisputeReason
  description    String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  escrowTxId String            @unique
  escrowTx   EscrowTransaction @relation(fields: [escrowTxId], references: [id])
  openedById String
  openedBy   User              @relation("DisputeOpener", fields: [openedById], references: [id])

  @@index([status, createdAt])
}

// USER: a personal notice for one specific buyer/seller (userId set).
// ADMIN: a staff broadcast alert visible to every isAdmin user (userId
// null) — a new high-value submission, a duplicate-cert fraud attempt, etc.
// One shared model/table (same reasoning as EscrowTransaction and
// ProvenanceEvent already being read by both sides), but the two audiences
// are queried and rendered through completely separate code paths — see
// getMyNotifications/getAdminAlerts in lib/queries.ts and
// components/site/notification-bell.tsx (consumer) vs
// components/warehouse/admin-alerts.tsx (staff-only).
enum NotificationAudience {
  USER
  ADMIN
}

enum NotificationType {
  ITEM_SOLD
  ITEM_PURCHASED
  INSPECTION_PASSED
  GRADING_COMPLETE
  PRICE_DROP_WATCHED
  NEW_SUBMISSION
  DUPLICATE_CERT_ATTEMPT
  OUTBID
  AUCTION_STARTING
  AUCTION_WON
  AUCTION_ENDED_SELLER
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  WANTED_CARD_LISTED
  TRADE_OFFER_RECEIVED
  TRADE_OFFER_ACCEPTED
  TRADE_OFFER_REJECTED
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  SHIPMENT_DISPATCHED
  SHIPMENT_DELIVERED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  CONTACT_MESSAGE
  SELLER_SHIP_REQUIRED
  SELLER_SHIPPED
  SALE_CANCELLED
}

model Notification {
  id        String               @id @default(cuid())
  audience  NotificationAudience
  type      NotificationType
  title     String
  body      String
  // Optional deep link, e.g. "/item/<id>" — where clicking the notification takes you.
  href      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  // Only set for USER-audience rows; always null for ADMIN broadcast alerts.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([audience, readAt])
}
